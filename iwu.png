<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DragonX - Streamer Profissional</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Rajdhani', 'Segoe UI', sans-serif;
        }

        @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&display=swap');

        :root {
            --primary: #8A2BE2;
            --secondary: #4169E1;
            --dark: #0a0a1a;
            --light: #f8f9fa;
            --accent: #FF00FF;
            --neon: #00ffff;
            --matrix: #00ff00;
        }

        body {
            background: 
                radial-gradient(circle at 20% 80%, rgba(138, 43, 226, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(65, 105, 225, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(255, 0, 255, 0.05) 0%, transparent 50%),
                linear-gradient(135deg, #0a0a1a 0%, #000000 100%);
            color: var(--light);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Efeito de scanlines */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                repeating-linear-gradient(
                    0deg,
                    rgba(0, 0, 0, 0.03) 0px,
                    rgba(0, 0, 0, 0.03) 1px,
                    transparent 1px,
                    transparent 2px
                );
            pointer-events: none;
            z-index: 2;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
            position: relative;
            z-index: 10;
        }

        /* Header e Perfil Gamer */
        header {
            text-align: center;
            padding: 80px 20px 60px;
            position: relative;
        }

        .profile-container {
            position: relative;
            display: inline-block;
            margin-bottom: 50px;
        }

        .profile-frame {
            position: relative;
            width: 250px;
            height: 250px;
            border-radius: 20px;
            background: linear-gradient(45deg, var(--primary), var(--secondary), var(--accent));
            padding: 8px;
            animation: frameGlow 3s ease-in-out infinite alternate;
            box-shadow: 
                0 0 50px rgba(138, 43, 226, 0.6),
                inset 0 0 20px rgba(255, 255, 255, 0.1);
        }

        .profile-pic {
            width: 100%;
            height: 100%;
            border-radius: 15px;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.1);
            filter: saturate(1.2) contrast(1.1);
            transition: all 0.5s ease;
        }

        .profile-pic:hover {
            filter: saturate(1.5) contrast(1.3) brightness(1.1);
            transform: scale(1.02);
        }

        .level-badge {
            position: absolute;
            bottom: -15px;
            right: -10px;
            background: linear-gradient(45deg, #ff0000, #ff6b6b);
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.9rem;
            box-shadow: 0 5px 15px rgba(255, 0, 0, 0.4);
            animation: pulse 2s infinite;
        }

        .name {
            font-size: 5rem;
            font-weight: 800;
            margin: 40px 0 20px;
            background: linear-gradient(45deg, var(--primary), var(--secondary), var(--accent), var(--neon));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 
                0 0 30px rgba(138, 43, 226, 0.8),
                0 0 60px rgba(138, 43, 226, 0.4);
            letter-spacing: 3px;
            position: relative;
            animation: textShine 3s ease-in-out infinite alternate;
        }

        .name::after {
            content: 'PRO STREAMER';
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1.2rem;
            color: var(--neon);
            text-shadow: 0 0 10px var(--neon);
            font-weight: 600;
            letter-spacing: 2px;
        }

        .title {
            font-size: 1.4rem;
            color: #ccc;
            margin: 60px 0 40px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
            position: relative;
        }

        .title::before {
            content: '🎮';
            position: absolute;
            left: -40px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.8rem;
        }

        .title::after {
            content: '🎮';
            position: absolute;
            right: -40px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.8rem;
        }

        /* Seção de Plataformas */
        .section-title {
            text-align: center;
            font-size: 3.5rem;
            margin-bottom: 80px;
            color: var(--light);
            position: relative;
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
        }

        .section-title::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 4px;
            background: linear-gradient(90deg, transparent, var(--neon), transparent);
        }

        .platforms-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
            margin-top: 50px;
        }

        /* Cards Gamer com Efeitos Especiais */
        .platform-card {
            background: 
                linear-gradient(135deg, 
                    rgba(255, 255, 255, 0.05) 0%, 
                    rgba(255, 255, 255, 0.02) 50%,
                    rgba(255, 255, 255, 0.05) 100%);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
            box-shadow: 
                0 10px 30px rgba(0, 0, 0, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .platform-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.1),
                transparent
            );
            transition: left 0.8s ease;
        }

        .platform-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, 
                rgba(138, 43, 226, 0.1) 0%, 
                rgba(65, 105, 225, 0.1) 50%,
                rgba(255, 0, 255, 0.1) 100%);
            opacity: 0;
            transition: opacity 0.4s ease;
            border-radius: 20px;
        }

        .platform-card:hover {
            transform: 
                translateY(-15px) 
                scale(1.03) 
                rotateX(5deg) 
                rotateY(5deg);
            box-shadow: 
                0 25px 50px rgba(138, 43, 226, 0.4),
                0 0 80px rgba(138, 43, 226, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(138, 43, 226, 0.3);
        }

        .platform-card:hover::before {
            left: 100%;
        }

        .platform-card:hover::after {
            opacity: 1;
        }

        /* Ícones com Efeito Hover Especial */
        .platform-icon {
            font-size: 4.5rem;
            margin-bottom: 25px;
            background: linear-gradient(45deg, var(--primary), var(--secondary), var(--accent));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 10px rgba(138, 43, 226, 0.5));
            transition: all 0.5s ease;
            position: relative;
            z-index: 2;
        }

        .platform-card:hover .platform-icon {
            transform: 
                scale(1.3) 
                rotateY(15deg);
            filter: 
                drop-shadow(0 0 20px rgba(138, 43, 226, 0.8))
                hue-rotate(45deg);
        }

        .platform-name {
            font-size: 2.2rem;
            margin-bottom: 20px;
            font-weight: 700;
            color: var(--light);
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
            position: relative;
            z-index: 2;
        }

        .platform-desc {
            color: #bbb;
            margin-bottom: 30px;
            line-height: 1.7;
            font-size: 1.1rem;
            position: relative;
            z-index: 2;
            text-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        }

        /* Botões com Efeito Gamer */
        .platform-btn {
            display: inline-block;
            padding: 16px 40px;
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: white;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.4s ease;
            border: none;
            cursor: pointer;
            box-shadow: 
                0 5px 20px rgba(138, 43, 226, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            position: relative;
            overflow: hidden;
            font-size: 1.1rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            z-index: 2;
        }

        .platform-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.6s ease;
        }

        .platform-btn:hover {
            transform: scale(1.08);
            box-shadow: 
                0 8px 30px rgba(138, 43, 226, 0.7),
                0 0 40px rgba(138, 43, 226, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.3);
            background: linear-gradient(45deg, var(--secondary), var(--primary));
            letter-spacing: 1.5px;
        }

        .platform-btn:hover::before {
            left: 100%;
        }

        /* Animações Gamer */
        @keyframes frameGlow {
            0% {
                box-shadow: 
                    0 0 50px rgba(138, 43, 226, 0.6),
                    inset 0 0 20px rgba(255, 255, 255, 0.1);
            }
            100% {
                box-shadow: 
                    0 0 70px rgba(138, 43, 226, 0.8),
                    0 0 100px rgba(65, 105, 225, 0.4),
                    inset 0 0 30px rgba(255, 255, 255, 0.2);
            }
        }

        @keyframes textShine {
            0% {
                text-shadow: 
                    0 0 30px rgba(138, 43, 226, 0.8),
                    0 0 60px rgba(138, 43, 226, 0.4);
            }
            100% {
                text-shadow: 
                    0 0 40px rgba(138, 43, 226, 1),
                    0 0 80px rgba(138, 43, 226, 0.6),
                    0 0 100px rgba(65, 105, 225, 0.4);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 5px 15px rgba(255, 0, 0, 0.4);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 8px 25px rgba(255, 0, 0, 0.6);
            }
        }

        /* Partículas Gamer */
        .particles-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
            animation: float 15s infinite ease-in-out;
            filter: blur(1px);
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }
            33% {
                transform: translateY(-20px) rotate(120deg);
            }
            66% {
                transform: translateY(10px) rotate(240deg);
            }
        }

        /* Footer Gamer */
        footer {
            text-align: center;
            padding: 50px 40px;
            margin-top: 100px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            color: #ccc;
            font-size: 1.1rem;
            position: relative;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }

        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--primary), var(--accent), transparent);
        }

        .god-bless {
            margin-top: 20px;
            font-style: italic;
            color: var(--neon);
            font-size: 1rem;
            text-shadow: 0 0 10px var(--neon);
        }

        /* Responsividade */
        @media (max-width: 768px) {
            .name {
                font-size: 3.5rem;
            }
            
            .platforms-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .profile-frame {
                width: 200px;
                height: 200px;
            }
            
            .section-title {
                font-size: 2.5rem;
            }
            
            .platform-card {
                padding: 30px 20px;
            }
            
            header {
                padding: 60px 20px 40px;
            }
        }
    </style>
</head>
<body>
    <div class="particles-container" id="particles"></div>
    
    <div class="container">
        <header>
            <div class="profile-container">
                <div class="profile-frame">
                    <img src="IMG_20251119_172137.png" alt="DragonX" class="profile-pic">
                </div>
                <div class="level-badge">LEVEL 99</div>
            </div>
            <h1 class="name">DRAGONX</h1>
            <p class="title">Venha fazer parte da minha comunidade e acompanhar conteúdos incríveis de games e entretenimento!</p>
        </header>
        
        <section id="platforms">
            <h2 class="section-title">REDES SOCIAIS</h2>
            
            <div class="platforms-grid">
                <div class="platform-card">
                    <i class="fab fa-tiktok platform-icon"></i>
                    <h3 class="platform-name">TikTok</h3>
                    <p class="platform-desc">Clipes épicos e momentos especiais das minhas lives e gameplays!</p>
                    <a href="https://www.tiktok.com/@dragonx656564?_r=1&_t=ZS-91XPFQG7Jvb" target="_blank" class="platform-btn">Seguir</a>
                </div>
                
                <div class="platform-card">
                    <i class="fab fa-twitch platform-icon"></i>
                    <h3 class="platform-name">Twitch</h3>
                    <p class="platform-desc">Perfil secundário para lives especiais (em manutenção temporária)</p>
                    <a href="https://www.twitch.tv/lordruan2003" target="_blank" class="platform-btn">Visitar</a>
                </div>
                
                <div class="platform-card">
                    <i class="fab fa-youtube platform-icon"></i>
                    <h3 class="platform-name">YouTube</h3>
                    <p class="platform-desc">Gameplays completas de FNF e outros jogos favoritos da comunidade!</p>
                    <a href="https://youtube.com/@titiodragonx" target="_blank" class="platform-btn">Inscrever</a>
                </div>
                
                <div class="platform-card">
                    <i class="fab fa-discord platform-icon"></i>
                    <h3 class="platform-name">Discord</h3>
                    <p class="platform-desc">Junte-se à nossa comunidade para conversar e participar de eventos!</p>
                    <a href="https://discord.gg/VW7ETaWAQ" target="_blank" class="platform-btn">Entrar</a>
                </div>
                
                <div class="platform-card">
                    <i class="fas fa-donate platform-icon"></i>
                    <h3 class="platform-name">LivePix</h3>
                    <p class="platform-desc">Apoie meu trabalho e ajude a melhorar o conteúdo. Muito obrigado!</p>
                    <a href="https://livepix.gg/ruanvitors118" target="_blank" class="platform-btn">Apoiar</a>
                </div>
            </div>
        </section>
    </div>
    
    <footer>
        <p>&copy; 2025 DragonX. Todos os direitos reservados.</p>
        <p class="god-bless">Que Deus abençoe cada um de vocês!</p>
    </footer>

    <script>
        // Partículas Gamer
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            const particleCount = 25;
            
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                
                const size = Math.random() * 40 + 10;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                particle.style.left = `${Math.random() * 100}vw`;
                particle.style.top = `${Math.random() * 100}vh`;
                
                const hue = Math.random() * 30 + 240;
                const opacity = Math.random() * 0.3 + 0.1;
                particle.style.background = `radial-gradient(circle, hsla(${hue}, 80%, 65%, ${opacity}) 0%, transparent 70%)`;
                
                particle.style.animationDuration = `${Math.random() * 20 + 10}s`;
                particle.style.animationDelay = `${Math.random() * 5}s`;
                
                particlesContainer.appendChild(particle);
            }
        }

        // Efeitos de hover avançados
        function setupHoverEffects() {
            const cards = document.querySelectorAll('.platform-card');
            
            cards.forEach(card => {
                card.addEventListener('mouseenter', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    
                    this.style.setProperty('--mouse-x', `${x}px`);
                    this.style.setProperty('--mouse-y', `${